# Salin ke .env lalu sesuaikan
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Ganti di production! Minimal 32 karakter acak.
JWT_SECRET=lyco-dev-secret-ganti-di-production-min-32-karakter
JWT_EXPIRES_IN=12h

# Akun admin awal (dibuat saat seed / boot pertama). Password di-hash bcrypt.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=lyco123

# SQLite file (node:sqlite bawaan Node 22+). Kosongkan DB_PATH untuk :memory:.
DB_PATH=./data/lyco.db

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=2

# Notif WA otomatis (Fonnte-compatible) saat admin ubah status -> diproses/selesai/batal.
# Daftar di https://fonnte.com, salin token device, isi ke WA_API_KEY lalu restart backend.
# Tanpa ini: backend tetap balas link wa.me manual sebagai fallback (tidak otomatis).
WA_API_KEY=
WA_API_URL=https://api.fonnte.com/send
WA_SENDER=
WA_AUTO_SEND=true
WA_TIMEOUT_MS=10000
